# Final Develop Image
FROM node:10-alpine

WORKDIR /app/

# Install system dependencies
RUN set -ex; \
    apk add --update --no-cache \
    make gcc g++ git python pwgen netcat-openbsd bash imagemagick

# Some transitive deps are pinned to git:// URLs, whose port (9418) is firewalled on
# some hosts; rewrite to https:// so npm install doesn't hang on those clones.
RUN git config --global url."https://github.com/".insteadOf git://github.com/

EXPOSE 3000 3003 3004

# Keep container running, so you can access it
CMD tail -f /dev/null