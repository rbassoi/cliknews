<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{companyName}}</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f4; font-family:Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4; padding:32px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; max-width:480px; width:100%; border:1px solid #e5e5e5;">
                    <tr>
                        <td style="padding:40px 32px; text-align:center;">
                            <div style="font-size:26px; font-weight:800; color:#0b3d24; letter-spacing:-0.02em;">Cliker</div>

                            <h1 style="font-size:20px; font-weight:700; color:#1c8a4c; margin:24px 0 16px;">Novo cadastro aguardando aprovação</h1>

                            <p style="font-size:14px; line-height:1.6; color:#333333; margin:0 0 8px; text-align:left;">
                                <strong>Empresa:</strong> {{companyName}}<br>
                                <strong>Contato:</strong> {{contactName}}<br>
                                <strong>E-mail:</strong> {{contactEmail}}
                            </p>

                            <table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px auto 0;">
                                <tr>
                                    <td style="background-color:#0d0d0d; border-radius:6px;">
                                        <a href="{{approvalUrl}}" style="display:inline-block; padding:14px 28px; font-size:13px; font-weight:700; letter-spacing:0.04em; color:#ffffff; text-decoration:none; text-transform:uppercase;">Revisar cadastro</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
